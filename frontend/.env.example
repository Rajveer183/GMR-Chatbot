# Copy to .env.local and adjust. All values are optional.

# Backend base URL baked into a production build (npm run build / Dockerfile).
# Leave empty in development: the Vite dev server proxies /api to the backend.
VITE_API_BASE=

# Dev-server proxy target (vite.config.ts): backend host, and the ports to
# probe -- the first one listening is used.
VITE_API_HOST=127.0.0.1
VITE_API_PORT=8000,8001

# Copy to .env and fill in the empty values. Every key below is required:
# shared/config.py refuses to start when one is missing (no built-in defaults).

# --- Data lake connection (db_connection/) -----------------------------------
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
PROJECT_BUCKET=
PREFIX_BRONZE=bronze
PREFIX_SILVER=silver
PREFIX_HES_SILVER=silver/hes_silver
PREFIX_GOLD=gold
PREFIX_HES_GOLD=gold/hes_gold
PREFIX_ATHENA=athena-results
GLUE_DB_BRONZE=
GLUE_DB_SILVER=
GLUE_DB_HES_SILVER=
GLUE_DB_GOLD=
GLUE_DB_HES_GOLD=
DB_HOST=
DB_NAME=
DB_USER=postgres
DB_PASSWORD=
DATABASE_URL=

# --- Groq (free tier) --------------------------------------------------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
ENABLE_LLM=1
GROQ_CALL_TIMEOUT=20
GROQ_DEFAULT_TPM=8000
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=hannah
GROQ_TTS_SPEED=1.15
GROQ_TTS_MAX_CHARS=900
GROQ_TTS_TIMEOUT=60
GROQ_TTS_CACHE_SIZE=64

# --- NVIDIA NIM (free tier) --------------------------------------------------
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
ENABLE_NVIDIA=1
NVIDIA_TIMEOUT=25
NVIDIA_THINKING=0
NVIDIA_MIN_MAX_TOKENS=2048

# --- Extra OpenAI-compatible providers (free tiers) -------------------------
LLM_EXTRA_PROVIDERS=gemini
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
GEMINI_REASONING_EFFORT=low
EXTRA_PROVIDER_TIMEOUT=12

# --- LLM gateway: model order per pipeline stage ("provider:model,...") ------
LLM_MODELS_TRIAGE=groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-120b,gemini:models/gemini-3.5-flash-lite,groq:openai/gpt-oss-20b,gemini:models/gemini-3.5-flash,nvidia:openai/gpt-oss-20b,gemini:models/gemma-4-26b-a4b-it,gemini:models/gemini-flash-lite-latest,gemini:models/gemini-3.1-flash-lite,nvidia:nvidia/nemotron-3-ultra-550b-a55b,nvidia:nvidia/nemotron-3.5-lightning-30b-a3b
LLM_MODELS_SQL=gemini:models/gemini-flash-lite-latest,groq:openai/gpt-oss-120b,gemini:models/gemini-3.5-flash,gemini:models/gemini-3-flash-preview,gemini:models/gemini-3.6-flash,gemini:models/gemini-2.5-flash,nvidia:openai/gpt-oss-20b,gemini:models/gemma-4-26b-a4b-it,groq:openai/gpt-oss-20b,gemini:models/gemini-3.5-flash-lite,nvidia:nvidia/nemotron-3-ultra-550b-a55b,gemini:models/gemini-3.1-flash-lite,nvidia:nvidia/nemotron-3.5-lightning-30b-a3b
LLM_MODELS_ANSWER=groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-20b,groq:openai/gpt-oss-120b,gemini:models/gemini-3.5-flash-lite,nvidia:openai/gpt-oss-20b,gemini:models/gemini-3.5-flash,gemini:models/gemini-2.5-flash,gemini:models/gemma-4-26b-a4b-it,gemini:models/gemini-flash-lite-latest,gemini:models/gemini-3.1-flash-lite,nvidia:nvidia/nemotron-3.5-lightning-30b-a3b
LLM_MODELS_EXPLAIN=groq:openai/gpt-oss-20b,groq:qwen/qwen3.8-27b,gemini:models/gemini-3.5-flash-lite,groq:openai/gpt-oss-120b,gemini:models/gemini-3.5-flash,nvidia:openai/gpt-oss-20b,gemini:models/gemma-4-26b-a4b-it,gemini:models/gemini-flash-lite-latest,nvidia:nvidia/nemotron-3.5-lightning-30b-a3b
# question's answer, so a weak reply here costs nothing but a slightly blander recalled memory.
# substrings that mark a model as the cheap/fast tier or the strong/expensive tier. A "simple"
LLM_MAX_REPAIRS=2
AGENT_MAX_STEPS=14

# --- LLM rate limiting (shared/rate_limiter.py, enforced in llm_gateway._admit) ---
LLM_DECODING=triage=0/1/0,sql=0/1/0,repair=0.2/1/0,answer=0.2/0.95/0,explain=0.3/0.95/0
LLM_TOP_K_PROVIDERS=
TOKEN_FACTORS=default=1.09,nvidia=1.09,groq=1.0,gemini=1.09
LLM_PRICING=gemini=0/0,groq=0/0,nvidia=0/0
QUESTION_MAX_COST_USD=0.05
PROMPT_COMPACT=
SLO_P50_MS=6000
SLO_P95_MS=15000
SLO_TTFT_P50_MS=5000
SLO_MAX_REFUSAL_RATE=0.08
SLO_MAX_BUSY_RATE=0.02
SLO_MAX_REPAIR_RATE=0.07
SLO_MAX_TOKENS_PER_QUESTION=13000
QUESTION_MAX_DB_QUERIES=8
AGENT_SQL_TIMEOUT_MS=15000
QUESTION_MAX_LLM_CALLS=16
QUESTION_MAX_TOKENS=80000
MAX_CONTEXT_TOKENS=32000
MAX_HISTORY_TOKENS=900
MAX_TOOL_RESULT_TOKENS=1800
PROMPT_ORDER=edges
SCHEMA_SCOPE=lean
CONTEXT_BUDGET_SQL_TOKENS=8500
CHUNK_MIN_TOKENS=60
CHUNK_MAX_TOKENS=450
GROUNDING_KPI_CHUNKS=2
GROUNDING_MIN_RELEVANCE=0.62
GROUNDING_TOP_K=6
GROUNDING_MAX_CONTEXT_CHARS=9000
LLM_RATE_WINDOW_SECONDS=60
LLM_RATE_MAX_WAIT_SECONDS=3
# every model cooling down: wait this long for the first one to free up instead of answering "busy"
LLM_BUSY_WAIT_SECONDS=30
LLM_RPM_LIMITS=gemini:10,groq:30,nvidia:40
LLM_TPM_LIMITS=gemini:250000
LLM_RATE_BACKOFF_BASE_SECONDS=10
QUESTION_LLM_BUDGET=75
LLM_MIN_CALL_SECONDS=3
LLM_MAX_REFILL_WAIT=2.5
LLM_FAILURE_COOLDOWN=15
LLM_TIMEOUT_COOLDOWN=120
LLM_MAX_RATE_LIMIT_COOLDOWN=120
LLM_MAX_DAILY_LIMIT_COOLDOWN=3600
LLM_MAX_TOKENS_TRIAGE=700
LLM_MAX_TOKENS_SQL=1400
LLM_MAX_TOKENS_ANSWER=1200
LLM_MAX_TOKENS_EXPLAIN=900

# --- Pipeline sizes ----------------------------------------------------------
SCHEMA_TOKEN_BUDGET=2400
ANSWER_PREVIEW_ROWS=25
TABLE_MAX_ROWS=500
CHART_MAX_POINTS=40
EXAMPLES_PER_QUESTION=3
ROUTED_EXAMPLES=0

# --- Hybrid retrieval: BM25 + local embeddings (gmr_agents/schema/retrieval.py) ---
RETRIEVAL_EMBED_ENABLED=1
RETRIEVAL_EMBED_MODEL=BAAI/bge-small-en-v1.5
RETRIEVAL_MODEL_DIR=outputs/models
RETRIEVAL_BM25_K1=1.5
RETRIEVAL_BM25_B=0.75
RETRIEVAL_RRF_K=60
RETRIEVAL_BM25_WEIGHT=1.5
RETRIEVAL_EMBED_WEIGHT=1.0
RETRIEVAL_MIN_SIMILARITY=0.5
KNOWLEDGE_FILE=knowledge.json
SQL_RESULT_FILE=sql_results.json
SQL_RESULT_CACHE_ENABLED=1
SQL_RESULT_CACHE_MAX_ROWS=5000
RETRIEVAL_VECTOR_TOP_N=60
TRIAGE_EXAMPLE_MENU_SIZE=8
TRIAGE_TOPIC_FULL=0
CHART_GUIDE_FULL=0
RETRIEVAL_QUERY_PREFIX=
RETRIEVAL_DOC_PREFIX=
FUZZY_ENABLED=1
FUZZY_MIN_RATIO=0.85
RETRIEVAL_QUERY_CACHE_SIZE=2000
RETRIEVAL_RESULT_CACHE_SIZE=5000
RETRIEVAL_ITEMS_TTL=60
RETRIEVAL_SQL_WEIGHT=0.5
SCHEMA_HINT_COLUMNS=8
PAST_QUESTIONS_TOP_K=2
PAST_QUESTIONS_MIN_SCORE=0.03
PAST_QUESTIONS_MAX=3000
ROUTER_ENABLED=1
ROUTER_MIN_RATIO=0.85
VERIFY_ENTITIES=1

# --- Data skeleton (gmr_agents/schema/data_skeleton.py): read-only picture of every table ---
DATA_SKELETON_SAMPLE_PCT=2
DATA_SKELETON_SAMPLE_ROWS=5
DATA_SKELETON_MAX_COMBOS=200
DATA_SKELETON_ATHENA_MAX_ROWS=100000
DATA_SKELETON_MAX_AGE=86400
VALUE_HINTS=4
TABLE_HINTS=5

# --- Conversation memory (deep-dive follow-ups) ---
MEMORY_TURNS=8
MEMORY_DETAILED_TURNS=3
MEMORY_ANSWER_CHARS=220

# --- Redis (shared/redis_client.py): session cache, response cache, rate limit ---
# Optional layer: if REDIS_HOST is blank or Redis is unreachable, everything below
# falls back to the existing local-file / in-memory logic automatically (see
# redis_client.available()) -- Redis is never a single point of failure.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_HISTORY_TTL=86400           # seconds a session's Redis-mirrored history survives (24h)
REDIS_HISTORY_MAX_MESSAGES=20     # messages kept per session in Redis (not the LLM context window --
                                  # that is MEMORY_TURNS, already far smaller)
REDIS_RESPONSE_CACHE_TTL=3600     # answer_cache.py: Redis-side expiry on top of the existing version check
REDIS_RATE_LIMIT=20               # requests per REDIS_RATE_WINDOW per session (gmr_agents/main.py)
REDIS_RATE_WINDOW=60
REDIS_MAX_MEMORY_CONTEXT=2000     # characters: hard cap on retrieved episodic memory text in one prompt
REDIS_MAX_RETRIEVED_MEMORIES=3    # hard cap on how many episodic memories are retrieved per question

# --- Answer cache (gmr_agents/answer_cache.py) -------------------------------
ANSWER_CACHE_ENABLED=1
ANSWER_CACHE_MAX_ENTRIES=5000
ANSWER_CACHE_VERSION_TTL=60

# --- Cache pre-warmer (gmr_agents/prewarm.py) --------------------------------
PREWARM_ENABLED=1
PREWARM_QUESTIONS_FILE=eval/question_bank/questions.yaml
PREWARM_TOP_N=50
PREWARM_PAUSE=2
PREWARM_CHECK_SECONDS=300
PREWARM_START_DELAY=30
# free-tier budget: warm only the most-asked questions, at most 40 a run, once edits settle (15 min)
PREWARM_BANK=0
PREWARM_MAX_QUESTIONS=40
PREWARM_SETTLE_SECONDS=900

# --- Schema catalog cache (gmr_agents/schema/catalog.py) ----------------------
GMR_CATALOG_MAX_CACHE_AGE=3600

# --- Optional (code defaults apply when unset) --------------------------------
# LOG_LEVEL=INFO
# PG_STATEMENT_TIMEOUT_MS=30000
# PG_POOL_MAX=8
# GMR_CATALOG_REFRESH_WORKERS=4
# GMR_CATALOG_REFRESH_COOLDOWN=60
# GMR_CATALOG_CACHE_DIR=gmr_agents/cache
